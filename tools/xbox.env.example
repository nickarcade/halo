# Repo-local Xbox defaults. Copy to tools/xbox.env and adjust as needed.
XBOX_HOST=127.0.0.1
# Named boxes (bridged xemu instances). Keep the real addresses here, never in
# committed docs; commands and skills refer to these variables by name.
#   xemu-client: patched build under test (default deploy / cache-clear target)
#   xemu-host:   pristine build (oracle)
# XEMU_CLIENT_HOST=
# XEMU_HOST_HOST=
# XBOX_DEST=xE:\GAMES\halo-patched
# XBDM_HOST=127.0.0.1
# XBDM_PORT=731
