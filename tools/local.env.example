# Machine-local tool settings. Copy to tools/local.env (gitignored) and edit.
# Python tools read it through tools/internal/local_env.py (load_repo_env);
# shell tools source it. Variables already set in the environment win.
# Values containing spaces must be double-quoted.

# Xbox SDK install (provides the VC71 compiler CL.Exe and xbcp.exe). CMake reads
# this variable from the environment too.
# RXDK_ROOT="/mnt/c/Program Files (x86)/RXDK"

# Ghidra install, project directory and script directory used by batch_delink.py.
# GHIDRA_INSTALL_DIR=/mnt/c/Users/<you>/AppData/Roaming/ghidra/ghidra_12.0.3_PUBLIC
# GHIDRA_PROJECT_DIR=/mnt/c/Users/<you>/AppData/Roaming/ghidra/ghidra_12.0.3_PUBLIC/projects
# GHIDRA_SCRIPT_DIR=/mnt/c/Users/<you>/ghidra_scripts

# Windows Python used by tools/shell/mcp-servers.sh to run the Ghidra bridge.
# PYTHON_WIN=/mnt/c/Users/<you>/scoop/shims/python3.exe

# xemu executable and screenshot directory used by the xemu MCP server.
# XEMU_PATH=/mnt/c/path/to/xemu.exe
# XEMU_SCREENSHOT_DIR=/path/to/screenshots

# Directory holding the unpatched halo-memory-viewer (.halorec) recordings, e.g.
# <halo-memory-viewer>/recordings/unpatched.
# HALO_HALOREC_DIR=/path/to/halo-memory-viewer/recordings/unpatched
